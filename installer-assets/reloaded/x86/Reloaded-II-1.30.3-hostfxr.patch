diff --git a/source/Reloaded.Mod.Loader.Bootstrapper/HostFxrStatus.hpp b/source/Reloaded.Mod.Loader.Bootstrapper/HostFxrStatus.hpp
new file mode 100644
index 0000000..4f05af1
--- /dev/null
+++ b/source/Reloaded.Mod.Loader.Bootstrapper/HostFxrStatus.hpp
@@ -0,0 +1,9 @@
+#pragma once
+
+constexpr bool IsSuccessfulHostFxrInitialization(int result, const void* context)
+{
+    // hostfxr uses non-negative values for success, including the cases where
+    // a compatible runtime is already initialized in the target process.
+    return result >= 0 && context != nullptr;
+}
diff --git a/source/Reloaded.Mod.Loader.Bootstrapper/HostFxrStatusTests.cpp b/source/Reloaded.Mod.Loader.Bootstrapper/HostFxrStatusTests.cpp
new file mode 100644
index 0000000..b9a947d
--- /dev/null
+++ b/source/Reloaded.Mod.Loader.Bootstrapper/HostFxrStatusTests.cpp
@@ -0,0 +1,16 @@
+#include "HostFxrStatus.hpp"
+
+#include <cassert>
+
+int main()
+{
+    const void* context = reinterpret_cast<const void*>(1);
+
+    assert(IsSuccessfulHostFxrInitialization(0, context));
+    assert(IsSuccessfulHostFxrInitialization(1, context));
+    assert(IsSuccessfulHostFxrInitialization(2, context));
+    assert(!IsSuccessfulHostFxrInitialization(-1, context));
+    assert(!IsSuccessfulHostFxrInitialization(0, nullptr));
+    return 0;
+}
