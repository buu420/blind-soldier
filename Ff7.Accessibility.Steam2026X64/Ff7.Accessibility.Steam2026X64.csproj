    <!--
      The cue schedule only. Deliberately NOT OpeningMoviePathResolver /
      OpeningMovieActivityPolicy / OpeningMovieProbeLifetime: those are the legacy
      runtime's file-handle polling stack, which exists because the 2013 game gives
      no signal that the movie started. This runtime is told directly by a native
      hook, which is a better anchor; porting the poller would add a second, worse
      detector racing the good one.
    -->
    <Compile Include="..\Ff7.Accessibility.Reloaded\OpeningMovieDescription.cs" Link="Shared\OpeningMovieDescription.cs" />
    <!--
      This runtime loads the opening audio-description track (Mod.cs resolves
      OpeningMovieAudioTrackPath against it) but declared it nowhere, so it reached
      installs only because the package script bulk-copies the asset tree. It was
      the one asset present in the legacy project and absent here. Working by
      coincidence is not working: any narrowing of that copy would have removed the
      narration from every Steam 2026 install with a completely green build.
    -->
    <None Include="..\Ff7.Accessibility.Reloaded\Assets\arcade\basketball_rise_tick.wav"
